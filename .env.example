# Copy to .env and fill in real values. Never commit .env.

POSTGRES_USER=eve
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eve_manufacturing

REDIS_PASSWORD=change-me

# Identify yourself to CCP: app name plus a contact, e.g. "eve-manufacturing (you@example.com)".
ESI_USER_AGENT=eve-manufacturing

APP_PORT=8000
LOG_LEVEL=INFO

# Leave both empty to disable HTTP basic auth.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# Optional cache and session lifetimes (seconds).
SESSION_TTL_SECONDS=1209600
ITEM_NAMES_CACHE_SECONDS=604800
ROUTE_CACHE_SECONDS=86400
ROUTE_ERROR_CACHE_SECONDS=300

# Shared refresh policy. Source cache expiry may delay requests beyond these intervals.
MARKET_REFRESH_SECONDS=1200
HISTORY_CACHE_SECONDS=86400
MANUFACTURING_CACHE_SECONDS=86400
INVENTION_PRICE_TTL_SECONDS=86400
INVENTION_PLAN_TTL_SECONDS=604800
TRADING_METADATA_TTL_SECONDS=604800
REFRESH_RETRY_SECONDS=300
