# Copy to .env and fill in real values. Never commit .env.

POSTGRES_USER=eve
POSTGRES_PASSWORD=change-me
POSTGRES_DB=eve_manufacturing

REDIS_PASSWORD=change-me

# Identify yourself to CCP: app name plus a contact, e.g. "eve-manufacturing (you@example.com)".
ESI_USER_AGENT=eve-manufacturing

APP_PORT=8000
LOG_LEVEL=INFO

# Leave both empty to disable HTTP basic auth.
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=
